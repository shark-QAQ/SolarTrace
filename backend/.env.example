# ============================================
# SolarTrace（光溯）后端环境变量示例
# 复制为 .env 后按需修改（.env 不入库）
# 前缀统一 SOLARTRACE_
# ============================================

# ---- 安全（生产必须更换）----
SOLARTRACE_SECRET_KEY=please-change-me-solartrace-prod
SOLARTRACE_ENVIRONMENT=development
SOLARTRACE_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 数据库（默认 SQLite 于 backend/data）----
# 生产可切 PostgreSQL：
# SOLARTRACE_DATABASE_URL=postgresql+psycopg://solartrace:pass@localhost:5432/solartrace

# ---- 向量库（默认 Chroma 本地持久；生产可切 Qdrant 需先起 docker compose 的 qdrant）----
SOLARTRACE_VECTOR_BACKEND=chroma
# SOLARTRACE_VECTOR_BACKEND=qdrant
SOLARTRACE_QDRANT_URL=http://localhost:6333
SOLARTRACE_VECTOR_DIMENSION=1024

# ---- 嵌入 / 生成（Ollama 已内置 bge-m3 与 qwen2.5:7b）----
SOLARTRACE_OLLAMA_BASE_URL=http://localhost:11434
SOLARTRACE_EMBEDDING_PROVIDER=ollama        # ollama | hash(离线退避)
SOLARTRACE_EMBEDDING_MODEL=bge-m3
SOLARTRACE_LLM_PROVIDER=ollama              # ollama | fake(离线/测试)
SOLARTRACE_LLM_MODEL=qwen2.5:7b
SOLARTRACE_LLM_TEMPERATURE=0.2
SOLARTRACE_LLM_NUM_CTX=8192

# ---- 两阶段精排 ----
SOLARTRACE_RERANK_BACKEND=deterministic    # auto|deterministic|cross_encoder(需配模型)
SOLARTRACE_RERANK_TOP_K=5

# ---- 检索 / 分块 ----
SOLARTRACE_RECALL_DENSE_TOP_K=30
SOLARTRACE_RECALL_BM25_TOP_K=30
SOLARTRACE_RRF_K=60.0
SOLARTRACE_MIN_SCORE_KEEP=0.30
SOLARTRACE_CHUNK_SIZE=300
SOLARTRACE_CHUNK_OVERLAP=60
SOLARTRACE_PARENT_MAX_CHARS=1800

# ---- 上传 ----
SOLARTRACE_MAX_UPLOAD_MB=20

# ---- 初始管理员（仅首次启动空库时生效）----
SOLARTRACE_BOOTSTRAP_ADMIN_USERNAME=admin
SOLARTRACE_BOOTSTRAP_ADMIN_PASSWORD=admin123

# ---- 日志 / CORS ----
SOLARTRACE_LOG_LEVEL=INFO
SOLARTRACE_LOG_FORMAT=text                  # text|json
SOLARTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
