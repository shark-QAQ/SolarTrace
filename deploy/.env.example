# docker compose 用的环境变量（cp 到仓库根 .env 后 docker compose ... 自动读取）
SOLARTRACE_SECRET_KEY=please-change-me-solartrace-prod
SOLARTRACE_VECTOR_BACKEND=chroma            # chroma | qdrant(需 --profile qdrant)
SOLARTRACE_QDRANT_URL=http://qdrant:6333
SOLARTRACE_OLLAMA_BASE_URL=http://host.docker.internal:11434
SOLARTRACE_EMBEDDING_MODEL=bge-m3
SOLARTRACE_LLM_MODEL=qwen2.5:7b
SOLARTRACE_BOOTSTRAP_ADMIN_USERNAME=admin
SOLARTRACE_BOOTSTRAP_ADMIN_PASSWORD=admin123
